# Copy this file to .env and fill in your own values. Never commit .env.

# --- Gmail sending (only required if you run with --send) ---
# Use a Gmail App Password, not your normal password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Claude API (used to draft each email) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Your profile, used to personalize each email ---
YOUR_NAME=Jane Doe
TARGET_ROLE=Backend Software Engineer
YOUR_SKILLS=Python, Django, PostgreSQL, AWS
YOUR_SUMMARY=3 years building backend services for fintech products.
YOUR_UNIVERSITY=Your University (optional — leave blank to omit from emails)
RESUME_PATH=./data/resume.pdf
